# Copy to apps/api/.env to override defaults. Every variable is optional; shell variables win over this file.

# development | test | production
NODE_ENV=development
PORT=3000

# SQLite file URL. Relative paths resolve from apps/api, for both the app and the Prisma CLI.
DATABASE_URL=file:./prisma/dev.db

# Comma-separated browser origins allowed by CORS (bare origins: no path, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Serve Swagger UI at /api/docs. Defaults to true unless NODE_ENV=production.
# SWAGGER_ENABLED=true

# HMAC key for signing access tokens; at least 32 characters. Required when NODE_ENV=production,
# otherwise a development-only default is used. Generate one with: openssl rand -base64 48
# JWT_SECRET=

# Access token lifetime in seconds (default: 43200 = 12 hours).
# JWT_EXPIRES_IN_SECONDS=43200
